@model ImageClient.Models.DTO.ImageUploadDTO

@{
    ViewData["Title"] = "Upload ảnh";
    var categories = ViewBag.Categories as List<ImageClient.Models.DTO.CategoryDTO>
                     ?? new List<ImageClient.Models.DTO.CategoryDTO>();
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Upload ảnh mới</h4>
                </div>
                <div class="card-body">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <form asp-action="Upload" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">Chọn file ảnh</label>
                            <input asp-for="File" type="file" class="form-control" accept="image/*" />
                            <span asp-validation-for="File" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Tên file</label>
                            <input asp-for="FileName" class="form-control" />
                            <span asp-validation-for="FileName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Mô tả</label>
                            <textarea asp-for="FileDescription" class="form-control" rows="2"></textarea>
                        </div>

                        <!-- ===== CHỌN PHÂN LOẠI ===== -->
                        <div class="mb-3">
                            <label class="form-label">Phân loại</label>
                            <select asp-for="CategoryId" class="form-select">
                                <option value="">-- Chọn loại --</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Upload</button>
                            <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>